FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-container.txt ./
RUN python -m pip install --no-cache-dir -r requirements-container.txt
COPY ai_server.py database.py webtoon_personalization.py kmas_webtoon_provider.py ./

USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "ai_server:app", "--host", "0.0.0.0", "--port", "8000"]
