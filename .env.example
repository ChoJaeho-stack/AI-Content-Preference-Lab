
# Database
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=contentlab_staging
DB_USER=contentlab_staging
DB_PASSWORD=
DB_SSL_CA=

# Authentication
JWT_SECRET=

# AI
CONTENTLAB_AI_MODE=disabled
GEMINI_API_KEY=

# KMAS Open API
KMAS_API_MODE=mock
KMAS_API_APPROVED=false
KMAS_API_BASE_URL=
KMAS_API_KEY=
KMAS_PAGE_SIZE=100
KMAS_MAX_PAGES=10

# KMAS content permissions
KMAS_SYNOPSIS_DISPLAY_ALLOWED=false
KMAS_COVER_DISPLAY_ALLOWED=false

# Webtoon recommendation providers
WEBTOON_RECOMMENDATION_PROVIDERS=contentlab_demo_fictional

# Web
CONTENTLAB_WEB_PORT=18080
CONTENTLAB_CACHE_ENABLED=false
SPRING_DATA_REDIS_URL=
CONTENTLAB_JDBC_PARAMS=

# Docker images
CONTENTLAB_WEB_IMAGE=
CONTENTLAB_AI_IMAGE=
